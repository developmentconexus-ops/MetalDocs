APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8080
# Optional frontend override. In local dev, Vite derives the proxy target from APP_PORT by default.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
API_IMAGE=metaldocs-api:dev
WORKER_IMAGE=metaldocs-worker:dev
WEB_IMAGE=metaldocs-web:dev

# Repository mode: memory | postgres
METALDOCS_REPOSITORY=postgres

# Auth middleware
METALDOCS_AUTH_ENABLED=true
METALDOCS_AUTHZ_CACHE_TTL_SECONDS=30
METALDOCS_AUTH_SESSION_SECRET=change_me
METALDOCS_AUTH_SESSION_COOKIE_NAME=metaldocs_session
METALDOCS_AUTH_SESSION_TTL_HOURS=12
METALDOCS_AUTH_SESSION_IDLE_MINUTES=30
METALDOCS_AUTH_COOKIE_SECURE=false
METALDOCS_AUTH_PASSWORD_MIN_LENGTH=8
METALDOCS_AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
METALDOCS_AUTH_LOGIN_LOCK_MINUTES=15
METALDOCS_AUTH_ORIGIN_PROTECTION_ENABLED=true
METALDOCS_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1
# First-boot bootstrap admin is local-only and opt-in. Fresh local bootstrap uses db/dev-seeds.
METALDOCS_BOOTSTRAP_ADMIN_ENABLED=false
METALDOCS_BOOTSTRAP_ADMIN_USER_ID=admin-local
METALDOCS_BOOTSTRAP_ADMIN_USERNAME=admin
METALDOCS_BOOTSTRAP_ADMIN_EMAIL=
METALDOCS_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
METALDOCS_BOOTSTRAP_ADMIN_PASSWORD=change_me
# Cross-origin policy
# Production recommendation: keep same-origin behind reverse proxy when possible.
# Enable CORS only for explicit allowed origins.
METALDOCS_CORS_ENABLED=false
METALDOCS_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
METALDOCS_CORS_ALLOWED_METHODS=GET,POST,PUT,OPTIONS
METALDOCS_CORS_ALLOWED_HEADERS=Content-Type,X-Trace-Id
METALDOCS_CORS_EXPOSED_HEADERS=
METALDOCS_CORS_ALLOW_CREDENTIALS=false
METALDOCS_CORS_MAX_AGE_SECONDS=300

# Used only in memory repository mode for local auth simulation.
# Format: user1:admin,user2:viewer|reviewer
METALDOCS_DEV_USER_ROLES=admin-local:admin

# PostgreSQL runtime — this is the identity metaldocs-api/worker/jobs connect
# as (A6.1 re-cut, issue #88). It must be the dedicated non-owner,
# non-superuser, non-bypassrls metaldocs_runtime role, NOT the bootstrap
# superuser below: internal/platform/db/postgres.AssertSafeIdentity boot-fatals
# otherwise. scripts/start-api.ps1 runs the metaldocs-dbprovision one-shot
# binary (which provisions metaldocs_runtime and applies grants/migrations
# as the bootstrap superuser, POSTGRES_USER/POSTGRES_PASSWORD below) before
# launching api/worker/jobs against this identity.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=metaldocs
PGUSER=metaldocs_runtime
PGPASSWORD=metaldocs_runtime_dev
PGSSLMODE=disable
# PGPASSWORD above and METALDOCS_RUNTIME_DB_PASSWORD below are TWO INDEPENDENT
# LITERALS, not one shared source. config.LoadPostgresConfig reads PGPASSWORD
# directly via os.Getenv with no reference to METALDOCS_RUNTIME_DB_PASSWORD,
# and vice versa (config.LoadRuntimeIdentityConfig never reads PGPASSWORD).
# They only agree today because both are hand-set to the same value below --
# nothing enforces that. If you change one, change the other, or api/worker/
# jobs will authenticate with a password metaldocs_runtime no longer has.
#
# metaldocs-dbprovision reads METALDOCS_RUNTIME_DB_PASSWORD and sets it as
# metaldocs_runtime's actual login password (ALTER ROLE metaldocs_runtime
# PASSWORD ...) every time it runs, AFTER role creation and BEFORE any DDL
# stage. It is REQUIRED -- unset fails provisioning closed (config.
# LoadRuntimeIdentityConfig returns an error naming this var) rather than
# substituting a value, because db/grants/0000_identity_roles.sql
# deliberately creates the role with no password and a silent fallback here
# would defeat that (issue #88 / A6.1, PR #110 review, CodeRabbit).
#
# Rotation: change this value AND PGPASSWORD above to match, then re-run
# metaldocs-dbprovision (`compose up` re-runs the db-provision service;
# scripts/start-api.ps1 runs it directly) so the role's actual password is
# rotated BEFORE restarting api/worker/jobs with the new value -- restarting
# them first would authenticate with a password the role does not have yet.
METALDOCS_RUNTIME_DB_PASSWORD=metaldocs_runtime_dev

# Compose database bootstrap. This is the BOOTSTRAP SUPERUSER — used only by
# Postgres's own initdb.d and by metaldocs-dbprovision (the one-shot
# provisioning binary/service); no long-running app process connects as it.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=metaldocs
POSTGRES_USER=metaldocs_app
POSTGRES_PASSWORD=change_me

# Optional DSN fallback. DATABASE_URL (and METALDOCS_DATABASE_URL, which wins
# over it if both are set) takes PRECEDENCE over PGHOST/PGPORT/PGDATABASE/
# PGUSER/PGPASSWORD above in config.LoadPostgresConfig -- if you uncomment
# this, its embedded password is a THIRD independent literal, not read by
# LoadRuntimeIdentityConfig or LoadPostgresConfig's PGPASSWORD path. Rotating
# METALDOCS_RUNTIME_DB_PASSWORD and PGPASSWORD without also updating this line
# leaves api/worker/jobs authenticating with the stale embedded password.
# DATABASE_URL=postgres://metaldocs_runtime:metaldocs_runtime_dev@127.0.0.1:5433/metaldocs?sslmode=disable

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# Attachments storage
METALDOCS_STORAGE_PROVIDER=minio
METALDOCS_ATTACHMENTS_ROOT=non_git/attachments
METALDOCS_ATTACHMENTS_SIGNING_SECRET=change_me
METALDOCS_ATTACHMENTS_DOWNLOAD_TTL_SECONDS=300
METALDOCS_MINIO_ENDPOINT=127.0.0.1:9000
METALDOCS_MINIO_ACCESS_KEY=minioadmin
METALDOCS_MINIO_SECRET_KEY=change_me
METALDOCS_MINIO_BUCKET=metaldocs-attachments
METALDOCS_MINIO_USE_SSL=false
METALDOCS_MINIO_AUTO_CREATE_BUCKET=true
METALDOCS_CARBONE_API_URL=http://carbone:4000

# Tenant crypto-shred KEK (M7 F7.3, ADR 0070 d4): base64 of exactly 32 raw
# bytes (AES-256 key-encryption key). Wraps each tenant's per-tenant DEK
# (metaldocs.tenant_keys.wrapped_dek). Unset = tenant crypto disabled
# (nil/no-op path; onboarding + audit payloads run without per-tenant
# envelope encryption). NEVER commit a real KEK value here or anywhere in
# git — generate locally, e.g.: openssl rand -base64 32
METALDOCS_TENANT_KEK=

# Worker
METALDOCS_WORKER_POLL_INTERVAL_SECONDS=10
METALDOCS_WORKER_BATCH_SIZE=25
METALDOCS_WORKER_RUN_ONCE=false
METALDOCS_WORKER_MAX_ATTEMPTS=5
METALDOCS_WORKER_RETRY_BASE_SECONDS=10
METALDOCS_WORKER_RETRY_MAX_SECONDS=300

# E2E smoke local-only seed
METALDOCS_E2E_ADMIN_USER_ID=e2e-admin
METALDOCS_E2E_ADMIN_USERNAME=e2e.admin
METALDOCS_E2E_ADMIN_EMAIL=e2e.admin@local.test
METALDOCS_E2E_ADMIN_DISPLAY_NAME=E2E Admin
METALDOCS_E2E_ADMIN_PASSWORD=E2eAdmin123!

# Go local dev cache (recommended for restricted environments)
# GOCACHE=.gocache

# MDDM Native DOCX Export rollout percentage (0 = shadow only, 100 = all users)
METALDOCS_MDDM_NATIVE_EXPORT_ROLLOUT_PCT=0

# --- docx-renderer (token substitution service, /render/fanout) ---
# See .env.docx-renderer.example for full block.
DOCX_RENDERER_SERVICE_TOKEN=dev-local-service-token-32chars!!
# Local dev (scripts/dev-docx-renderer.ps1): service runs on :3001
# Docker compose: override to http://docx-renderer:3100 (host port 3110)
METALDOCS_FANOUT_URL=http://localhost:3001
METALDOCS_DOCX_RENDERER_SERVICE_TOKEN=dev-local-service-token-32chars!!
