# Exclude dev artifacts that should never be in the Docker build context.
# Applies to all images built from the repo root (api, worker, web).

.git
.git/**
.gitignore

# Node.js — each image runs its own npm ci inside the container
**/node_modules
**/node_modules/**

# Go deps are downloaded inside builder images.
vendor
vendor/**

# Frontend build output (Vite/Next) — not needed in context
frontend/**/dist
frontend/**/.next
frontend/**/.turbo

# Go test / coverage artifacts
**/*_test.go.tmp
**/coverage.out
metaldocs-api.exe
metaldocs-worker.exe
.tmp-go

# Local dev/run artifacts.
.codex-run
.codex-run/**
non_git
non_git/**
tmp
tmp/**
temp
temp/**
logs
logs/**
*.log

# Local dev env files
.env.local
.env.*.local
**/.env.local

# Editor / OS noise
.vscode
.idea
**/.DS_Store
**/Thumbs.db

# Worktrees
.worktrees

# Agent/session dirs — can grow to hundreds of MB; never build inputs
.claude
.claude/**
.codex*
.clone
.clone/**
.gomodcache
.gomodcache/**
backups
backups/**

# F8.1 Task A: secrets must never enter the build context.
.env
.env.*
# (.env.local / .env.*.local already excluded above; kept as-is.)

# F8.1 Task A: docs tree is not a build input.
docs/
docs/**

# F8.1 Task A: vendored third-party sources verified not a Go build input.
third_party/
third_party/**

# F8.1 Task A: stray local build artifacts (e.g. apps/api/cmd/metaldocs-api/metaldocs-api.exe).
**/*.exe
