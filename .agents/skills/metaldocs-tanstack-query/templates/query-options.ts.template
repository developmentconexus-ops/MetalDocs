import { queryOptions, useQuery } from "@tanstack/react-query";

import { QK } from "../../../lib/queryKeys";
import { getDomainEntity } from "../api/domain";

export function domainEntityQueryOptions(id: string) {
  return queryOptions({
    queryKey: QK.domain.detail(id),
    queryFn: () => getDomainEntity(id),
    enabled: Boolean(id),
    staleTime: 30_000,
  });
}

export function useDomainEntityQuery(id: string) {
  return useQuery(domainEntityQueryOptions(id));
}
